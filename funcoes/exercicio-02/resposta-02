def calcular_compra(preco, quantidade):
    total = preco * quantidade
    return total


# Informando o preço e a quantidade de produtos
preco = 5.50
quantidade = 4

# Armazenando o resultado em uma variável
valor_total = calcular_compra(preco, quantidade)

# Exibindo o valor final da compra
print("O valor total da compra é: R$", valor_total)
